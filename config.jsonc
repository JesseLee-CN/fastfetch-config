{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "~/.config/fastfetch/ascii.txt",
        "color": {
            "1": "#4E87D0"
        },
        "padding": {
            "top": 5,
            "left": 3
        }
    },
    "display": {
        "separator": " "
    },
    "modules": [
        "break",
        {
            "type": "custom",
            "format": "\u001b[90m┌─────────────────────────────────── Hardware ───────────────────────────────────┐"
        },
        {
            "type": "host",
            "key": "│  PC     ",
            "keyColor": "green",
            "keyWidth": 15
        },
        {
            "type": "cpu",
            "key": "│ ├ CPU   ",
            "keyColor": "green",
            "keyWidth": 15
        },
        {
            "type": "gpu",
            "key": "│ ├ GPU   ",
            "keyColor": "green",
            "keyWidth": 15
        },
        {
            "type": "memory",
            "key": "│ ├ RAM   ",
            "keyColor": "green",
            "keyWidth": 15
        },
        {
            "type": "disk",
            "key": "│ ├ Disk  ",
            "keyColor": "green",
            "keyWidth": 15
        },
        {
            "type": "display",
            "key": "│ └ Display",
            "keyColor": "green",
            "keyWidth": 15
        },
        {
            "type": "custom",
            "format": "\u001b[90m└────────────────────────────────────────────────────────────────────────────────┘"
        },
        "break",
        {
            "type": "custom",
            "format": "\u001b[90m┌─────────────────────────────────── Software ───────────────────────────────────┐"
        },
        {
            "type": "os",
            "key": "│  OS     ",
            "keyColor": "yellow",
            "keyWidth": 15
        },
        {
            "type": "kernel",
            "key": "│ ├ Kernel ",
            "keyColor": "yellow",
            "keyWidth": 15
        },
        {
            "type": "bios",
            "key": "│ ├ BIOS   ",
            "keyColor": "yellow",
            "keyWidth": 15
        },
        {
            "type": "packages",
            "key": "│ ├󰏖 Pkgs   ",
            "keyColor": "yellow",
            "keyWidth": 15
        },
        {
            "type": "shell",
            "key": "│ └ Shell  ",
            "keyColor": "yellow",
            "keyWidth": 15
        },
        {
            "type": "custom",
            "format": "\u001b[90m└────────────────────────────────────────────────────────────────────────────────┘"
        },
        "break",
        {
            "type": "custom",
            "format": "\u001b[90m┌─────────────────────────────────── Desktop ────────────────────────────────────┐"
        },
        {
            "type": "wm",
            "key": "│ ├ WM     ",
            "keyColor": "blue",
            "keyWidth": 15
        },
        {
            "type": "wmtheme",
            "key": "│ ├󰉼 Theme  ",
            "keyColor": "blue",
            "keyWidth": 15
        },
        {
            "type": "terminal",
            "key": "│ ├ Term   ",
            "keyColor": "blue",
            "keyWidth": 15
        },
        {
            "type": "font",
            "key": "│ └ Font   ",
            "keyColor": "blue",
            "keyWidth": 15
        },
        {
            "type": "custom",
            "format": "\u001b[90m└────────────────────────────────────────────────────────────────────────────────┘"
        },
        "break",
        {
            "type": "custom",
            "format": "\u001b[90m┌────────────────────────────── Uptime / DateTime ───────────────────────────────┐"
        },
        {
            "type": "uptime",
            "key": "│  Uptime   ",
            "keyColor": "magenta"
        },
        {
            "type": "datetime",
            "key": "│  DateTime ",
            "keyColor": "magenta"
        },
        {
            "type": "custom",
            "format": "\u001b[90m└────────────────────────────────────────────────────────────────────────────────┘"
        },
        "break",
        {
            "type": "colors",
            "paddingLeft": 3,
            "symbol": "circle"
        }
    ]
}
